# All calls go through the customer's deployed new-api/OwlAI site.
NEWAPI_BASE_URL=https://www.owlai.top
# Seedance models use this key (for example, doubao-seedance-2-0-fast-260128).
SEEDANCE_API_KEY=<customer site token>
# HappyHorse requests use this key (pass --provider happyhorse).
HAPPYHORSE_API_KEY=<customer site token>
IMAGE_API_KEY=<customer site token>

# Optional per-channel overrides. If omitted, scripts use NEWAPI_BASE_URL.
# VIDEO_API_BASE_URL=https://your-new-api.example.com
# IMAGE_API_BASE_URL=https://your-new-api.example.com

# Optional defaults for the bundled scripts.
IMAGE_MODEL=gpt-image-2
INFERENCE_MODEL=gpt-5.5
